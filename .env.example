# Copy to .env and fill in values before running in production

# REQUIRED in production: long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string

# Admin credentials — used only when no user exists in the database yet
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Optional
PORT=3001
NODE_ENV=production
