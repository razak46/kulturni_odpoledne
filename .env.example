# Copy to .env and fill in values before running locally or in production

# REQUIRED: Neon (or any PostgreSQL) connection string
# Get a free database at https://neon.tech → create project → copy connection string
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# REQUIRED in production: long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string

# Admin credentials — used only when no user exists in the database yet
# On Vercel, set these in Project Settings → Environment Variables
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Optional
PORT=3001
NODE_ENV=production
